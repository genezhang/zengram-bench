node_modules/
dist/
# Everything under results/ is regenerable bench data / experiment output —
# never source code. Ignore ALL of it, keeping only the placeholder .gitkeeps so
# results/runs and results/scores still exist after a fresh clone. This one rule
# deliberately covers everything the old near-miss patterns let slip: ad-hoc
# archive dirs (results/_archive-*, hyphen, at the results/ root), experiment
# dirs (exp*, pilot*), multi-session-state AND multi-session-state-qwen,
# ablation*, baselines, runs-ornith, scores-ornith, scores_archive_*, etc.
# Previously ~19 GB of this showed as untracked-but-not-ignored and could be
# staged by a stray `git add`.
results/*
!results/runs/
!results/scores/
results/runs/*
!results/runs/.gitkeep
results/scores/*
!results/scores/.gitkeep
tasks/cache/*.json
__pycache__/
*.pyc
.env
